WEB_PORT=8443
PUBLIC_ORIGIN=https://localhost:8443
PUBLIC_ORIGIN_ALIASES=
POSTGRES_USER=wkb
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=wkb
DATABASE_URL=postgresql://wkb:change_me_db_password@postgres:5432/wkb?schema=public
NODE_ENV=production
API_PORT=3000
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_at_least_32_random_characters
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Demo accounts (ada / grace / alan @wkb.local) with a public password, for local runs and evaluation.
# Set to false on any deployment reachable from the internet: the accounts are then not created, and existing ones are locked.
SEED_DEMO_USERS=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FT_CLIENT_ID=
FT_CLIENT_SECRET=